{
  "name": "monarque-astro-theme",
  "description": "A luxury editorial Astro and Tailwind CSS theme for premium magazines, journals, and curated publications.",
  "type": "module",
  "version": "2.0.0",
  "author": "Andrei Alba",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "tailwindcss",
    "magazine",
    "blog",
    "editorial",
    "luxury"
  ],
  "homepage": "https://monarque.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/monarque.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "qa:static": "node scripts/qa-static.mjs",
    "release:check": "npm run check && npm run build && npm run qa:static && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "github-slugger": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
