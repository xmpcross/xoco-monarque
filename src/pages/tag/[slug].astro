---
import { getCollection } from "astro:content";
import ArchiveGrid from "@/components/ArchiveGrid.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllTags, getPostsByTag, paginatePosts } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return getAllTags(posts).map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props as { tag: ReturnType<typeof getAllTags>[number] };
const posts = getPostsByTag(await getCollection("posts"), tag.slug);
const { posts: paginatedPosts, page } = paginatePosts(posts, 1, `/tag/${tag.slug}/`);
const archiveUrl = new URL(`/tag/${tag.slug}/`, siteConfig.siteUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Stories tagged ${tag.name}`,
    description: `Browse Monarque stories tagged ${tag.name}.`,
    url: archiveUrl,
    isPartOf: {
      "@type": "WebSite",
      name: siteConfig.name,
      url: siteConfig.siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Archive",
        item: new URL("/blog/", siteConfig.siteUrl).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: `#${tag.name}`,
        item: archiveUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={`#${tag.name}`}
  description={`Browse Monarque stories tagged ${tag.name}.`}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-[1440px] px-6 py-16 md:px-10 md:py-24">
    <nav class="flex flex-wrap items-center gap-3 text-sm text-muted" aria-label="Breadcrumb">
      <a class="link-line text-muted hover:text-pearl" href="/blog/">Archive</a>
      <span aria-hidden="true">/</span>
      <span class="text-gold" aria-current="page">#{tag.name}</span>
    </nav>
    <h1 class="display mt-4 max-w-4xl text-5xl leading-tight md:text-7xl">#{tag.name}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted md:text-xl">
      Stories tagged #{tag.name} from the Monarque archive.
    </p>

    <ArchiveGrid posts={paginatedPosts} page={page} />
  </section>
</BaseLayout>
