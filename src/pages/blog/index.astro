---
import { getCollection } from "astro:content";
import ArchiveGrid from "@/components/ArchiveGrid.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  assertValidContentRelationships,
  categories,
  categoryHref,
  getAllTags,
  paginatePosts,
  tagHref,
  visiblePosts,
} from "@/lib/content";

const allPosts = await getCollection("posts");
const authors = await getCollection("authors");
assertValidContentRelationships(allPosts, authors);

const posts = visiblePosts(allPosts);
const tags = getAllTags(posts);
const { posts: paginatedPosts, page } = paginatePosts(posts, 1, "/blog/");
---

<BaseLayout title="Latest Stories" description="Browse every Monarque dispatch across travel, hotels, style, cars, dining, interiors, watches, yachts, and private aviation.">
  <section class="mx-auto max-w-[1440px] px-6 py-16 md:px-10 md:py-24">
    <h1 class="display max-w-4xl text-5xl leading-tight md:text-7xl">Latest stories from Monarque</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted md:text-xl">
      A complete index of our demo editorial collection, structured as Astro content entries with colocated images.
    </p>

    <nav class="mt-10 flex flex-wrap gap-3" aria-label="Browse by category">
      {categories.map((category) => (
        <a class="chip" href={categoryHref(category.slug)}>{category.name}</a>
      ))}
    </nav>

    {tags.length > 0 && (
      <nav class="mt-6 flex flex-wrap gap-3" aria-label="Browse by tag">
        {tags.map((tag) => (
          <a class="link-line text-sm uppercase tracking-[0.14em] text-muted hover:text-pearl" href={tagHref(tag.name)}>
            #{tag.name}
          </a>
        ))}
      </nav>
    )}

    <ArchiveGrid posts={paginatedPosts} page={page} />
  </section>
</BaseLayout>
