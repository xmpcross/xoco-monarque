---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import LocalIcon from "@/components/LocalIcon.astro";
import PostCard from "@/components/PostCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import {
  assertValidContentRelationships,
  authorHref,
  categories,
  categoryHref,
  entrySlug,
  formatDate,
  getCategory,
  getEditorsPicks,
  getFeaturedPost,
  getPostsByCategory,
  getTrendingPosts,
  postHref,
  readingMinutes,
  visiblePosts,
} from "@/lib/content";

const allPosts = await getCollection("posts");
const authors = await getCollection("authors");
assertValidContentRelationships(allPosts, authors);

const home = siteConfig.home;
const posts = visiblePosts(allPosts);
const featured = getFeaturedPost(posts);
const featuredAuthor = featured ? authors.find((author) => entrySlug(author) === featured.data.author) : undefined;
const spotlight = getPostsByCategory(posts, home.spotlightCategory).find((post) => post.id !== featured?.id);
const latest = posts.filter((post) => post.id !== featured?.id && post.id !== spotlight?.id).slice(0, 4);
const leadPostIds = new Set([featured?.id, spotlight?.id, ...latest.map((post) => post.id)]);
const editorsPicks = getEditorsPicks(
  posts.filter((post) => !leadPostIds.has(post.id)),
  4,
);
const trending = getTrendingPosts(
  posts.filter((post) => post.id !== featured?.id),
  3,
);
---

<BaseLayout>
  {
    featured ? (
      <>
        <section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink" aria-labelledby="cover-title">
          <Image
            src={featured.data.cover.src}
            alt={featured.data.cover.alt}
            widths={[768, 1200, 1600, 2200, 2800]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 -z-10 h-full w-full object-cover brightness-[0.8] saturate-[0.9]"
          />
          <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(10_10_12/0.92)_0%,rgb(10_10_12/0.66)_38%,rgb(10_10_12/0.12)_75%)]" />
          <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(10_10_12/0.55)_0%,rgb(10_10_12/0)_22%,rgb(10_10_12/0)_50%,rgb(10_10_12/0.9)_100%)]" />

          <div class="shell flex flex-1 items-end pb-12 pt-32 md:pb-16">
            <div class="max-w-4xl">
              <a class="text-sm font-semibold text-gold transition-colors hover:text-pearl" href={categoryHref(featured.data.category)}>
                {getCategory(featured.data.category)?.name}
              </a>
              <h1 id="cover-title" class="display mt-5 text-5xl leading-[1.02] text-balance text-pearl md:text-7xl lg:text-8xl">
                <a class="transition-colors hover:text-gold" href={postHref(featured)}>
                  {featured.data.title}
                </a>
              </h1>
              <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pearl/85 md:text-xl">{featured.data.subtitle}</p>
              <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-pearl/80">
                {featuredAuthor && (
                  <a class="group flex items-center gap-3" href={authorHref(featuredAuthor)}>
                    <Image src={featuredAuthor.data.avatar.src} alt="" width={80} height={80} class="h-9 w-9 rounded-full object-cover ring-1 ring-pearl/30" />
                    <span class="font-semibold text-pearl group-hover:text-gold">{featuredAuthor.data.name}</span>
                  </a>
                )}
                <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
                <span aria-hidden="true" class="h-1 w-1 bg-pearl/50" />
                <span>{readingMinutes(featured)} min read</span>
              </div>
              <div class="mt-10 flex flex-wrap gap-3">
                <a class="button button-primary" href={postHref(featured)}>
                  Read the story
                  <LocalIcon name="arrow-up-right" class="h-4 w-4" />
                </a>
                <a class="button button-glass" href="/blog/">
                  Browse the archive
                </a>
              </div>
            </div>
          </div>

          {trending.length > 0 && (
            <div class="hidden border-t border-pearl/15 bg-ink/40 backdrop-blur-md md:block">
              <ol class="shell grid grid-cols-3 divide-x divide-pearl/15" aria-label={home.trendingLabel}>
                {trending.map((post, index) => (
                  <li class="group relative flex gap-5 px-6 py-6 first:pl-0 last:pr-0">
                    <span class="display text-3xl italic leading-none text-gold">{String(index + 1).padStart(2, "0")}</span>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-pearl/65">{getCategory(post.data.category)?.name}</p>
                      <a class="display mt-1.5 block text-xl leading-snug text-pearl transition-colors group-hover:text-gold" href={postHref(post)}>
                        <span class="absolute inset-0" aria-hidden="true" />
                        {post.data.title}
                      </a>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>

        <section class="shell py-20 md:py-28" aria-labelledby="latest-title">
          <SectionHead title={home.latestTitle} id="latest-title" href="/blog/" linkLabel="View all" />

          <div class="mt-12 grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
            {latest[0] && (
              <article class="group">
                <a class="block overflow-hidden" href={postHref(latest[0])} aria-label={`Read ${latest[0].data.title}`}>
                  <Image
                    src={latest[0].data.cover.src}
                    alt={latest[0].data.cover.alt}
                    widths={[768, 1024, 1400]}
                    sizes="(min-width: 1024px) 56vw, 100vw"
                    class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-[1.025]"
                  />
                </a>
                <div class="mt-7">
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">
                    <a class="text-gold hover:text-pearl" href={categoryHref(latest[0].data.category)}>
                      {getCategory(latest[0].data.category)?.name}
                    </a>
                    <span aria-hidden="true" class="h-1 w-1 bg-muted/60" />
                    <time datetime={latest[0].data.date.toISOString()}>{formatDate(latest[0].data.date, "short")}</time>
                  </div>
                  <h3 class="display mt-4 text-4xl leading-tight text-balance transition-colors group-hover:text-gold md:text-5xl">
                    <a href={postHref(latest[0])}>{latest[0].data.title}</a>
                  </h3>
                  <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted md:text-lg">{latest[0].data.excerpt}</p>
                </div>
              </article>
            )}
            <div class="grid divide-y divide-line">
              {latest.slice(1).map((post) => (
                <div class="py-6 first:pt-0 last:pb-0">
                  <PostCard post={post} variant="compact" />
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="bg-charcoal py-20 md:py-28" aria-labelledby="sections-title">
          <div class="shell">
          <SectionHead title={home.departmentsTitle} id="sections-title" href="/blog/" linkLabel="All stories" />
          <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {categories.map((category) => (
              <a class="group relative isolate flex min-h-[15rem] flex-col justify-end overflow-hidden bg-panel p-4 sm:min-h-[22rem] sm:p-6" href={categoryHref(category.slug)}>
                <Image
                  src={category.image}
                  alt=""
                  widths={[420, 640, 900]}
                  sizes="(min-width: 1024px) 25vw, 50vw"
                  class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/50 to-ink/5" />
                <span class="absolute right-5 top-5 grid h-9 w-9 place-items-center bg-pearl text-ink opacity-0 transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                  <LocalIcon name="arrow-up-right" class="h-4 w-4" />
                </span>
                <h3 class="display text-2xl leading-tight text-pearl sm:text-3xl">{category.name}</h3>
                <p class="mt-2 hidden text-sm leading-relaxed text-pearl/75 sm:block">{category.tagline}</p>
              </a>
            ))}
          </div>
          </div>
        </section>

        {spotlight && (
          <section class="shell pt-20 md:pt-28" aria-labelledby="spotlight-title">
            <div class="relative isolate flex min-h-[34rem] items-end overflow-hidden p-7 md:min-h-[38rem] md:items-center md:p-14">
              <Image
                src={spotlight.data.cover.src}
                alt=""
                widths={[768, 1200, 1600, 2200]}
                sizes="(min-width: 1440px) 1360px, 100vw"
                class="absolute inset-0 -z-10 h-full w-full object-cover"
              />
              <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-ink/10 md:bg-gradient-to-r md:from-ink/95 md:via-ink/60 md:to-transparent" />
              <div class="max-w-xl">
                <a class="text-sm font-semibold text-gold transition-colors hover:text-pearl" href={categoryHref(spotlight.data.category)}>
                  {getCategory(spotlight.data.category)?.name}
                </a>
                <h2 id="spotlight-title" class="display mt-4 text-4xl leading-tight text-balance md:text-6xl">
                  {spotlight.data.title}
                </h2>
                <p class="mt-5 text-base leading-relaxed text-pearl/85 md:text-lg">{spotlight.data.excerpt}</p>
                <a class="button button-glass mt-8" href={postHref(spotlight)}>
                  {home.spotlightCta}
                  <LocalIcon name="arrow-up-right" class="h-4 w-4" />
                </a>
              </div>
            </div>
          </section>
        )}

        {editorsPicks.length > 0 && (
          <section class="py-20 md:py-28" aria-labelledby="picks-title">
            <div class="shell">
              <SectionHead title={home.picksTitle} id="picks-title" />
              <div class:list={["mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2", editorsPicks.length >= 4 ? "lg:grid-cols-4" : "lg:grid-cols-3"]}>
                {editorsPicks.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </div>
          </section>
        )}

      </>
    ) : (
      <section class="shell max-w-[1180px] py-20 md:py-28">
        <h1 class="display max-w-4xl text-5xl leading-tight md:text-7xl">{home.emptyTitle}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted md:text-xl">{home.emptyDescription}</p>
      </section>
    )
  }
</BaseLayout>
